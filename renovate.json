{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>edithatogo/renovate-config"
  ],
  "automerge": false,
  "platformAutomerge": false,
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/.mise/locks/**",
    "**/.config/mise/locks/**",
    "legacy/standardflow/**"
  ],
  "pip_requirements": {
    "managerFilePatterns": ["requirements/*.txt"]
  },
  "packageRules": [
    {
      "description": "Keep updates reviewable until required repository checks are configured",
      "matchPackageNames": ["*"],
      "automerge": false,
      "platformAutomerge": false
    }
  ]
}
