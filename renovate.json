{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>edithatogo/renovate-config",
    "group:all"
  ],
  "automerge": false,
  "platformAutomerge": false,
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/.mise/locks/**",
    "**/.config/mise/locks/**",
    "legacy/standardflow/**"
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "requirements/*.txt"
    ]
  },
  "packageRules": [
    {
      "description": "One routine dependency update across maintained ecosystems",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "rollback"
      ],
      "groupName": "maintained dependencies",
      "groupSlug": "maintained-dependencies",
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "description": "Breaking updates proposed automatically, qualified separately",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "major dependency updates",
      "groupSlug": "major-dependency-updates",
      "dependencyDashboardApproval": false,
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "description": "Immutable workflow action references",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    }
  ],
  "prConcurrentLimit": 1,
  "separateMajorMinor": true,
  "pre-commit": {
    "enabled": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": null,
    "schedule": [],
    "automerge": false,
    "dependencyDashboardApproval": false
  },
  "dependencyDashboardApproval": false
}
