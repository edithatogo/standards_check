{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.standardflow.dev/artifact-recipe.v1.schema.json",
  "title": "StandardFlow artefact recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recipe_id", "version", "artifact_type", "inputs", "outputs", "accessibility"],
  "properties": {
    "schema_version": {"const": "dev.standardflow.artifact-recipe.v1"},
    "recipe_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
    "version": {"type": "string", "minLength": 1},
    "artifact_type": {"enum": ["checklist", "form", "flow_diagram", "timeline", "relationship_graph", "document", "research_object"]},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "outputs": {"type": "array", "minItems": 1, "items": {"enum": ["json", "markdown", "html", "svg", "pdf", "png", "tiff", "docx", "typst", "latex", "text"]}},
    "invariants": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reading_order", "text_equivalent"],
      "properties": {
        "reading_order": {"type": "boolean", "const": true},
        "text_equivalent": {"type": "boolean", "const": true},
        "keyboard_operable": {"type": "boolean"}
      }
    }
  }
}
