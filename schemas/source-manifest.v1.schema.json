{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.standardflow.dev/source-manifest.v1.schema.json",
  "title": "StandardFlow source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "dev.standardflow.source-manifest.v1"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "redistributed_in_pack"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "role": {"enum": ["authoritative_source", "migration_input", "explanation", "licence"]},
          "url": {"type": "string", "format": "uri"},
          "retrieved_at": {"type": "string", "format": "date"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "repository_path": {"type": "string", "minLength": 1},
          "git_blob_sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "local_legacy_path": {"type": "string", "minLength": 1},
          "redistributed_in_pack": {"type": "boolean"}
        },
        "allOf": [
          {
            "if": {"properties": {"role": {"const": "authoritative_source"}}},
            "then": {"required": ["url", "retrieved_at", "sha256"]}
          },
          {
            "if": {"properties": {"role": {"const": "migration_input"}}},
            "then": {"required": ["repository_path", "git_blob_sha1"]}
          }
        ]
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
